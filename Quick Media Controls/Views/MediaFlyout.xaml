<Window
    x:Class="Quick_Media_Controls.MediaFlyout"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="MediaFlyout"
    FontFamily="pack://application:,,,/Assets/Fonts/#Google Sans Flex"
    Width="332"
    Height="384"
    MinWidth="332"
    MinHeight="384"
    MaxWidth="332"
    MaxHeight="384"
    AllowDrop="False"
    Deactivated="Flyout_Deactivated"
    AllowsTransparency="True"
    WindowStyle="None"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    ResizeMode="NoResize"
    ShowActivated="True"
    ShowInTaskbar="False"
    Topmost="False"
    Background="Transparent"
    WindowStartupLocation="Manual"
    mc:Ignorable="d">

    <Window.Resources>
        <FontFamily x:Key="FlyoutFont">pack://application:,,,/Assets/Fonts/#Google Sans Flex</FontFamily>
        <FontFamily x:Key="FlyoutFontMedium">pack://application:,,,/Assets/Fonts/#Google Sans Flex Medium</FontFamily>

        <Style x:Key="PlayPauseFlyoutButtonStyle" TargetType="{x:Type ui:Button}">
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="11,5,11,6" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ui:Button}">
                        <Border
                            x:Name="ButtonBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                RecognizesAccessKey="True" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  Icon button with no hover or pressed box, only a small press effect  -->
        <Style x:Key="FlatIconButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Grid Background="Transparent">
                            <ContentPresenter
                                x:Name="Content"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                RenderTransformOrigin="0.5,0.5" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Content" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.88" ScaleY="0.88" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  Slider parts shared by the seek bar and the volume slider  -->
        <Style x:Key="FlyoutSliderTrackButtonStyle" TargetType="{x:Type RepeatButton}">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RepeatButton}">
                        <Grid Background="Transparent">
                            <Border
                                Height="4"
                                VerticalAlignment="Center"
                                Background="{TemplateBinding Background}"
                                CornerRadius="2" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FlyoutSliderThumbStyle" TargetType="{x:Type Thumb}">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Grid Background="Transparent">
                            <Ellipse
                                Width="12"
                                Height="12"
                                Fill="{TemplateBinding Foreground}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FlyoutSliderStyle" TargetType="{x:Type Slider}">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsMoveToPointEnabled" Value="True" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Slider}">
                        <Grid Background="Transparent" SnapsToDevicePixels="True">
                            <Border
                                Height="4"
                                VerticalAlignment="Center"
                                Background="{TemplateBinding Background}"
                                CornerRadius="2" />
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton
                                        Background="{TemplateBinding Foreground}"
                                        Command="{x:Static Slider.DecreaseLarge}"
                                        Style="{StaticResource FlyoutSliderTrackButtonStyle}" />
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton
                                        Background="Transparent"
                                        Command="{x:Static Slider.IncreaseLarge}"
                                        Style="{StaticResource FlyoutSliderTrackButtonStyle}" />
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Foreground="{TemplateBinding Foreground}" Style="{StaticResource FlyoutSliderThumbStyle}" />
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FlyoutVerticalTrackButtonStyle" TargetType="{x:Type RepeatButton}">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RepeatButton}">
                        <Grid Background="Transparent">
                            <Border
                                Width="4"
                                HorizontalAlignment="Center"
                                Background="{TemplateBinding Background}"
                                CornerRadius="2" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FlyoutVerticalSliderStyle" TargetType="{x:Type Slider}">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsMoveToPointEnabled" Value="True" />
            <Setter Property="Orientation" Value="Vertical" />
            <Setter Property="Width" Value="18" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Slider}">
                        <Grid Background="Transparent" SnapsToDevicePixels="True">
                            <Border
                                Width="4"
                                HorizontalAlignment="Center"
                                Background="{TemplateBinding Background}"
                                CornerRadius="2" />
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton
                                        Background="{TemplateBinding Foreground}"
                                        Command="{x:Static Slider.DecreaseLarge}"
                                        Style="{StaticResource FlyoutVerticalTrackButtonStyle}" />
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton
                                        Background="Transparent"
                                        Command="{x:Static Slider.IncreaseLarge}"
                                        Style="{StaticResource FlyoutVerticalTrackButtonStyle}" />
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Foreground="{TemplateBinding Foreground}" Style="{StaticResource FlyoutSliderThumbStyle}" />
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Window.ContextMenu>
        <ContextMenu>
            <MenuItem
                Name="MoveFlyoutToggle"
                Click="MoveFlyoutMenuItem_Click"
                Header="Move Flyout"
                IsCheckable="True" />
            <MenuItem Click="ResetPositionMenuItem_Click" Header="Reset Position">
                <MenuItem.Icon>
                    <ui:SymbolIcon FontSize="18" Symbol="ArrowReset24" />
                </MenuItem.Icon>
            </MenuItem>

            <MenuItem Click="GithubMenuItem_Click" Header="On Github">
                <MenuItem.Icon>
                    <ui:SymbolIcon
                        Filled="True"
                        FontSize="18"
                        Foreground="Gold"
                        Symbol="Star20" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Click="SettingsMenuItem_Click" Header="Settings">
                <MenuItem.Icon>
                    <ui:SymbolIcon FontSize="18" Symbol="Settings20" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Click="Exit_Click" Header="Exit Application">
                <MenuItem.Icon>
                    <ui:SymbolIcon FontSize="18" Symbol="ArrowExit20" />
                </MenuItem.Icon>
            </MenuItem>

        </ContextMenu>
    </Window.ContextMenu>
    <Grid x:Name="Root" Opacity="1">
        <!--  Soft shadow behind the card (the window itself is see-through)  -->
        <Border
            x:Name="CardShadow"
            Margin="16"
            Background="Black"
            CornerRadius="8">
            <Border.Effect>
                <DropShadowEffect
                    BlurRadius="22"
                    Direction="270"
                    Opacity="0.4"
                    ShadowDepth="3"
                    Color="Black" />
            </Border.Effect>
        </Border>

        <!--  The flyout card: rounded corners, own background  -->
        <Border
            x:Name="FlyoutCard"
            Margin="16"
            Background="#202024"
            CornerRadius="8"
            MouseLeftButtonDown="Window_MouseLeftButtonDown">
            <Border.Clip>
                <RectangleGeometry
                    RadiusX="8"
                    RadiusY="8"
                    Rect="0,0,300,352" />
            </Border.Clip>
            <Grid>
        <Grid x:Name="DynamicAmbientLayer" Visibility="Collapsed" IsHitTestVisible="False">
            <Border x:Name="DynamicAmbientBackground" />
            <Border x:Name="DynamicAmbientOverlay" />
        </Grid>

        <Grid x:Name="BlurredArtworkLayer" Visibility="Collapsed" IsHitTestVisible="False" ClipToBounds="True">
            <Image x:Name="BlurredArtworkImage" Stretch="UniformToFill" Margin="-20" Opacity="0.45" RenderOptions.BitmapScalingMode="HighQuality" />
            <Border x:Name="BlurredArtworkTintBorder" />
        </Grid>

        <Border x:Name="MinimalistGlassLayer" Visibility="Collapsed" IsHitTestVisible="False" />

        <Grid
            Name="mediaPlayingGrid"
            Margin="18,30,18,24"
            VerticalAlignment="Top">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  Album art  -->
            <Border
                x:Name="ThumbnailContainer"
                Grid.Row="0"
                Width="133"
                Height="133"
                HorizontalAlignment="Center"
                CornerRadius="10"
                BorderThickness="0">
                <Border.Effect>
                    <DropShadowEffect
                        x:Name="ThumbnailDropShadow"
                        BlurRadius="14"
                        Direction="270"
                        Opacity="0"
                        ShadowDepth="2"
                        Color="Black" />
                </Border.Effect>
                <ui:Image
                    Name="playingMediaThumbnail"
                    Width="133"
                    Height="133"
                    CornerRadius="10"
                    Visibility="Visible" />
            </Border>

            <!--  Title and artist  -->
            <ui:TextBlock
                Name="playingMediaTitle"
                Grid.Row="1"
                Margin="0,13,0,0"
                HorizontalAlignment="Center"
                FontFamily="{StaticResource FlyoutFontMedium}"
                FontSize="15"
                LineHeight="20"
                LineStackingStrategy="BlockLineHeight"
                Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"
                MaxWidth="264"
                TextTrimming="CharacterEllipsis" />
            <ui:TextBlock
                Name="playingMediaArtist"
                Grid.Row="2"
                Margin="0,2,0,0"
                HorizontalAlignment="Center"
                FontFamily="{StaticResource FlyoutFont}"
                FontSize="12"
                LineHeight="16"
                LineStackingStrategy="BlockLineHeight"
                Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                MaxWidth="264"
                TextTrimming="CharacterEllipsis" />

            <!--  Seek bar  -->
            <Grid Grid.Row="3" Margin="0,11,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Slider
                    x:Name="SeekSlider"
                    Grid.Row="0"
                    Background="#40808080"
                    Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"
                    IsEnabled="False"
                    LargeChange="10"
                    Maximum="1"
                    Minimum="0"
                    Opacity="0.45"
                    SmallChange="5"
                    Style="{StaticResource FlyoutSliderStyle}"
                    ValueChanged="SeekSlider_ValueChanged" />
                <Grid Grid.Row="1" Margin="2,0,2,0">
                    <TextBlock
                        x:Name="ElapsedTimeText"
                        HorizontalAlignment="Left"
                        FontFamily="{StaticResource FlyoutFont}"
                        FontSize="10"
                        LineHeight="13"
                        LineStackingStrategy="BlockLineHeight"
                        Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                        Text="0:00" />
                    <TextBlock
                        x:Name="TotalTimeText"
                        HorizontalAlignment="Right"
                        FontFamily="{StaticResource FlyoutFont}"
                        FontSize="10"
                        LineHeight="13"
                        LineStackingStrategy="BlockLineHeight"
                        Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                        Text="0:00" />
                </Grid>
            </Grid>

            <!--  Controls  -->
            <Grid Grid.Row="4" Margin="-6,17,-6,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel
                    Name="PlaybackButtonsGrid"
                    Grid.Column="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <ui:Button
                        Name="PreviousTrackButton"
                        MinWidth="0"
                        MinHeight="0"
                        Width="38"
                        Height="38"
                        Padding="0"
                        CornerRadius="19"
                        Click="PreviousButton_ClickAsync">
                        <ui:SymbolIcon
                            x:Name="PreviousIcon"
                            Filled="False"
                            FontSize="18"
                            Symbol="Previous16" />
                    </ui:Button>
                    <ui:Button
                        x:Name="PlayPauseButton"
                        MinWidth="0"
                        MinHeight="0"
                        Width="44"
                        Height="44"
                        Margin="10,0"
                        Padding="0"
                        Appearance="Primary"
                        CornerRadius="22"
                        Click="PlayPauseButton_ClickAsync">
                        <ui:SymbolIcon
                            Name="playPauseIcon"
                            Filled="True"
                            FontSize="18"
                            Symbol="Play12" />
                    </ui:Button>
                    <ui:Button
                        Name="NextTrackButton"
                        MinWidth="0"
                        MinHeight="0"
                        Width="38"
                        Height="38"
                        Padding="0"
                        CornerRadius="19"
                        Click="NextButton_ClickAsync">
                        <ui:SymbolIcon
                            x:Name="NextIcon"
                            Filled="False"
                            FontSize="18"
                            Symbol="Next16" />
                    </ui:Button>
                </StackPanel>

                <StackPanel
                    Grid.Column="2"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <ui:Button
                        Name="LockButton"
                        MinWidth="0"
                        MinHeight="0"
                        Width="28"
                        Height="28"
                        Padding="0"
                        Appearance="Transparent"
                        BorderBrush="Transparent"
                        CornerRadius="14"
                        Click="LockButton_Click">
                        <ui:SymbolIcon
                            Name="LockIcon"
                            FontSize="16"
                            Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                            Symbol="LockOpen16" />
                    </ui:Button>
                    <ui:Button
                        Name="CycleSessionButton"
                        MinWidth="0"
                        MinHeight="0"
                        Width="28"
                        Height="28"
                        Margin="6,0,0,0"
                        Padding="0"
                        Appearance="Transparent"
                        BorderBrush="Transparent"
                        CornerRadius="14"
                        Opacity="0.4"
                        IsHitTestVisible="False"
                        Click="CycleSessionButton_Click">
                        <ui:SymbolIcon
                            x:Name="CycleIcon"
                            FontSize="16"
                            Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                            Symbol="ArrowRight16" />
                    </ui:Button>
                </StackPanel>
            </Grid>

            <!--  Volume: speaker in the top-right corner; hover to slide out a vertical slider  -->
            <Grid
                x:Name="VolumePanel"
                Grid.Row="0"
                Grid.RowSpan="5"
                Width="36"
                Margin="0,-18,-6,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Background="Transparent"
                MouseEnter="VolumePanel_MouseEnter"
                MouseLeave="VolumePanel_MouseLeave"
                MouseLeftButtonDown="VolumePanel_MouseLeftButtonDown"
                Opacity="0.45">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Button
                    x:Name="VolumeButton"
                    Grid.Row="0"
                    Width="32"
                    Height="32"
                    HorizontalAlignment="Center"
                    Click="VolumeButton_Click"
                    IsEnabled="False"
                    Style="{StaticResource FlatIconButtonStyle}">
                    <ui:SymbolIcon
                        x:Name="VolumeIcon"
                        FontSize="19"
                        Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"
                        Symbol="Speaker216" />
                </Button>

                <Grid
                    x:Name="VolumeSliderHost"
                    Grid.Row="1"
                    Height="0"
                    ClipToBounds="True">
                    <Slider
                        x:Name="VolumeSlider"
                        Height="88"
                        Margin="0,4,0,4"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="#4D808080"
                        Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"
                        IsHitTestVisible="False"
                        LargeChange="0.1"
                        Maximum="1"
                        Minimum="0"
                        Opacity="0"
                        SmallChange="0.05"
                        Style="{StaticResource FlyoutVerticalSliderStyle}"
                        ValueChanged="VolumeSlider_ValueChanged" />
                </Grid>

                <TextBlock
                    x:Name="VolumePercentText"
                    Grid.Row="2"
                    HorizontalAlignment="Center"
                    FontFamily="{StaticResource FlyoutFontMedium}"
                    FontSize="10"
                    Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                    LineHeight="12"
                    LineStackingStrategy="BlockLineHeight"
                    Text="0%" />
            </Grid>
        </Grid>

        <Grid
            Name="noMediaPlayingGrid"
            Margin="12,0"
            Visibility="Collapsed">
            <StackPanel
                Name="noMediaPlayingPanel"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
                <ui:SymbolIcon
                    Name="noMediaPlayingIcon"
                    HorizontalAlignment="Center"
                    Filled="True"
                    FontSize="65"
                    Symbol="MusicNoteOff224" />
                <ui:TextBlock
                    Name="noPlayingMediaTitle"
                    Margin="0,12,0,0"
                    HorizontalAlignment="Center"
                    FontFamily="{StaticResource FlyoutFontMedium}"
                    FontSize="19"
                    Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"
                    Text="It’s a bit quiet in here..."
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
                <ui:TextBlock
                    Name="noPlayingMediaArtist"
                    Margin="0,4,0,0"
                    HorizontalAlignment="Center"
                    FontFamily="{StaticResource FlyoutFont}"
                    FontSize="13"
                    Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                    Text="Time to break the silence"
                    TextAlignment="Center" />
            </StackPanel>
        </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
